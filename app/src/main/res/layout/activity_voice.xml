<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Fechar"
            android:padding="11dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/TextAppearance.TaskFlow.H2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Tarefa por voz" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            style="@style/TextAppearance.TaskFlow.H1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Fale sua tarefa"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/status"
            style="@style/TextAppearance.TaskFlow.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Ex.: “Amanhã às 9h, revisar o relatório, urgente”" />

        <TextView
            android:id="@+id/aiBadge"
            style="@style/TextAppearance.TaskFlow.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="IA local (offline)"
            android:textColor="@color/brand_indigo"
            android:textSize="9sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/aiProgress"
            android:layout_width="180dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/brand_indigo"
            app:trackColor="@color/surface_alt" />

        <FrameLayout
            android:id="@+id/micWrap"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="30dp">

            <View
                android:id="@+id/micPulse"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_soft" />

            <ImageView
                android:id="@+id/micIcon"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_fab"
                android:contentDescription="Microfone"
                android:elevation="6dp"
                android:padding="22dp"
                android:src="@drawable/ic_mic"
                app:tint="@color/white" />
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultCard"
            style="@style/Widget.TaskFlow.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:visibility="gone"
            app:cardCornerRadius="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextAppearance.TaskFlow.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eu entendi" />

                <EditText
                    android:id="@+id/titleInput"
                    style="@style/TextAppearance.TaskFlow.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@null"
                    android:hint="Descreva a tarefa"
                    android:inputType="textCapSentences"
                    android:maxLines="2"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary" />

                <TextView
                    android:id="@+id/parsedMeta"
                    style="@style/TextAppearance.TaskFlow.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Hoje · 09:00 · Alta" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimary"
            style="@style/Widget.TaskFlow.Button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Falar agora"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_mic"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSecondary"
            style="@style/Widget.TaskFlow.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="Digitar manualmente"
            app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>
