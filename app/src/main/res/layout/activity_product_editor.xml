<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/screenTitle"
            style="@style/TextAppearance.TaskFlow.H2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Adicionar produto" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Excluir compra"
            android:padding="10dp"
            android:src="@drawable/ic_delete"
            android:visibility="gone"
            app:tint="@color/rose" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.TaskFlow.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="92dp"
            android:text="Salvar"
            android:textSize="13sp"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/photoCard"
                style="@style/Widget.TaskFlow.Card"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                app:cardCornerRadius="24dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Foto do produto"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/photoPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:src="@drawable/ic_add_photo_alternate"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            android:id="@+id/photoPlaceholderText"
                            style="@style/TextAppearance.TaskFlow.BodyStrong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Tire uma foto do produto" />

                        <TextView
                            style="@style/TextAppearance.TaskFlow.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="A IA preenche nome e preço para você" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/analysisOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#B3000000"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:indeterminate="true"
                            app:indicatorColor="@color/white"
                            app:trackColor="#33FFFFFF" />

                        <TextView
                            android:id="@+id/analysisText"
                            style="@style/TextAppearance.TaskFlow.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Analisando imagem..."
                            android:textColor="@color/white" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPhoto"
                    style="@style/Widget.TaskFlow.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="Foto do produto"
                    android:textSize="11.5sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_photo_camera"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="17dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBarcode"
                    style="@style/Widget.TaskFlow.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Código de barras"
                    android:textSize="11.5sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_qr_code_scanner"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="17dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/barcodeLabel"
                style="@style/TextAppearance.TaskFlow.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/brand_indigo"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTypeBarcode"
                style="@style/Widget.TaskFlow.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="8dp"
                android:text="Digitar código de barras"
                android:textColor="@color/brand_indigo"
                android:textSize="11.5sp" />

            <LinearLayout
                android:id="@+id/formContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/aiBadge"
                    style="@style/TextAppearance.TaskFlow.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="Reconhecido por IA ✨"
                    android:textColor="@color/brand_indigo"
                    android:textSize="9sp"
                    android:visibility="gone" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/nameLayout"
                    style="@style/Widget.TaskFlow.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Nome do produto"
                    app:endIconDrawable="@drawable/ic_mic"
                    app:endIconMode="custom"
                    app:endIconTint="@color/brand_indigo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.TaskFlow.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Quantidade" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageButton
                    android:id="@+id/btnQtyMinus"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Diminuir quantidade"
                    android:padding="11dp"
                    android:src="@drawable/ic_remove"
                    app:tint="@color/brand_indigo" />

                <EditText
                    android:id="@+id/qtyInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:text="1"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnQtyPlus"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Aumentar quantidade"
                    android:padding="11dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/brand_indigo" />

                <TextView
                    android:id="@+id/unitValue"
                    style="@style/TextAppearance.TaskFlow.BodyStrong"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_pill"
                    android:gravity="center"
                    android:minWidth="52dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="un"
                    android:textColor="@color/brand_indigo"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/priceLayout"
                style="@style/Widget.TaskFlow.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Preço pago">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/priceInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLength="14"
                    android:maxLines="1"
                    android:text="R$ 0,00" />
            </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.TaskFlow.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Preço informado é unitário"
                    android:textSize="11.5sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/priceUnitSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/itemTotal"
                style="@style/TextAppearance.TaskFlow.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Total do item: R$ 0,00"
                android:textColor="@color/brand_indigo"
                android:textSize="11.5sp" />

<LinearLayout
                android:id="@+id/dateField"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_calendar_month"
                    app:tint="@color/brand_indigo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.TaskFlow.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data da compra"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/dateValue"
                        style="@style/TextAppearance.TaskFlow.BodyStrong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hoje" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/placeLayout"
                style="@style/Widget.TaskFlow.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Local de compra"
                app:endIconDrawable="@drawable/ic_my_location"
                app:endIconMode="custom"
                app:endIconTint="@color/brand_indigo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/placeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/placeChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                style="@style/TextAppearance.TaskFlow.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Categoria" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/categoryGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="6dp"
                app:selectionRequired="true"
                app:singleSelection="true" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveBottom"
                style="@style/Widget.TaskFlow.Button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="Salvar compra"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
