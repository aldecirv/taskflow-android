<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/TextAppearance.TaskFlow.H2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Histórico de preços" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCsv"
            style="@style/Widget.TaskFlow.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="CSV"
            android:textSize="11sp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPdf"
            style="@style/Widget.TaskFlow.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="PDF"
            android:textSize="11sp"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/bg"
        app:tabIndicatorColor="@color/brand_indigo"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabRippleColor="#144F46E5"
        app:tabSelectedTextColor="@color/brand_indigo"
        app:tabTextColor="@color/text_secondary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ABA TABELA -->
        <LinearLayout
            android:id="@+id/tablePane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/sortGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:chipSpacingHorizontal="6dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/sortName"
                        style="@style/Widget.TaskFlow.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:checked="true"
                        android:text="Alfabética" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/sortUp"
                        style="@style/Widget.TaskFlow.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Maior alta" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/sortDown"
                        style="@style/Widget.TaskFlow.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Maior queda" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tableHint"
                style="@style/TextAppearance.TaskFlow.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="20dp"
                android:text="↓ baixou · ↑ subiu · média paga por mês" />

            <HorizontalScrollView
                android:id="@+id/headerScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/headerRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </HorizontalScrollView>

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                android:scrollbars="none">

                <HorizontalScrollView
                    android:id="@+id/bodyScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/bodyRows"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </HorizontalScrollView>
            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_receipt_long"
                    app:tint="@color/text_tertiary" />

                <TextView
                    style="@style/TextAppearance.TaskFlow.BodyStrong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Sem histórico ainda" />

                <TextView
                    style="@style/TextAppearance.TaskFlow.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Adicione compras para comparar preços mês a mês." />
            </LinearLayout>
        </LinearLayout>

        <!-- ABA GRÁFICOS -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/chartsPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="6dp"
                android:paddingEnd="20dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/filterProduct"
                            style="@style/TextAppearance.TaskFlow.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_input"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:maxLines="1"
                            android:maxWidth="180dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="Produto: todos"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/filterCategory"
                            style="@style/TextAppearance.TaskFlow.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_input"
                            android:gravity="center_vertical"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="Categoria: todas"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/filterPlace"
                            style="@style/TextAppearance.TaskFlow.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_input"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:maxLines="1"
                            android:maxWidth="160dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="Local: todos"
                            android:textSize="11sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.TaskFlow.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                style="@style/TextAppearance.TaskFlow.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gasto no mês"
                                android:textSize="8.5sp" />

                            <TextView
                                android:id="@+id/cardMonthTotal"
                                style="@style/TextAppearance.TaskFlow.H2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="R$ 0,00"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.TaskFlow.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                style="@style/TextAppearance.TaskFlow.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Maior alta"
                                android:textColor="@color/rose"
                                android:textSize="8.5sp" />

                            <TextView
                                android:id="@+id/cardRise"
                                style="@style/TextAppearance.TaskFlow.BodyStrong"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="—"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.TaskFlow.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                style="@style/TextAppearance.TaskFlow.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Maior queda"
                                android:textColor="@color/emerald"
                                android:textSize="8.5sp" />

                            <TextView
                                android:id="@+id/cardFall"
                                style="@style/TextAppearance.TaskFlow.BodyStrong"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="—"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.TaskFlow.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                style="@style/TextAppearance.TaskFlow.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Economia potencial"
                                android:textColor="@color/brand_indigo"
                                android:textSize="8.5sp" />

                            <TextView
                                android:id="@+id/cardSavings"
                                style="@style/TextAppearance.TaskFlow.BodyStrong"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="R$ 0,00"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.TaskFlow.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/TextAppearance.TaskFlow.H2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Evolução do preço"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/lineSubtitle"
                            style="@style/TextAppearance.TaskFlow.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Toque em um ponto para ver os detalhes" />

                        <com.taskflow.app.ui.widgets.PriceLineChartView
                            android:id="@+id/lineChart"
                            android:layout_width="match_parent"
                            android:layout_height="280dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.TaskFlow.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/TextAppearance.TaskFlow.H2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gastos por mês"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/barSubtitle"
                            style="@style/TextAppearance.TaskFlow.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Total pago em cada mês" />

                        <com.taskflow.app.ui.widgets.SpendBarChartView
                            android:id="@+id/barChart"
                            android:layout_width="match_parent"
                            android:layout_height="230dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/summary"
                    style="@style/TextAppearance.TaskFlow.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:lineSpacingExtra="2dp"
                    android:padding="14dp"
                    android:text="Resumo dos gastos filtrados" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
