<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <com.taskflow.app.ui.widgets.FramingOverlayView
        android:id="@+id/framing"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_camera_button"
        android:contentDescription="Fechar câmera"
        android:padding="11dp"
        android:src="@drawable/ic_close"
        app:tint="@color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="36dp">

        <ImageButton
            android:id="@+id/btnGallery"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginEnd="34dp"
            android:background="@drawable/bg_camera_button"
            android:contentDescription="Escolher da galeria"
            android:padding="14dp"
            android:src="@drawable/ic_image"
            app:tint="@color/white" />

        <FrameLayout
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:background="@drawable/bg_shutter">

            <ImageButton
                android:id="@+id/btnShutter"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_shutter_inner"
                android:contentDescription="Capturar foto"
                android:src="@drawable/ic_photo_camera"
                app:tint="@color/white" />
        </FrameLayout>

        <Space
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="34dp" />
    </LinearLayout>
</FrameLayout>
