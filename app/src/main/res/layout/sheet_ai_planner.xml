<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_soft"
                android:gravity="center"
                android:text="✦"
                android:textColor="@color/brand_indigo"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.TaskFlow.H1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Planejador inteligente"
                    android:textSize="20sp" />

                <TextView
                    style="@style/TextAppearance.TaskFlow.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Descreva seu objetivo e receba a semana organizada." />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/aiStatus"
            style="@style/TextAppearance.TaskFlow.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="Modo local · sem chave do Gemini"
            android:textColor="@color/brand_indigo"
            android:textSize="9sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.TaskFlow.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="O que você quer planejar?">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/promptEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5"
                android:minLines="3"
                android:text="Quero organizar meu trabalho e estudar inglês esta semana" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerate"
            style="@style/Widget.TaskFlow.Button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:text="Gerar plano com IA"
            android:textSize="13sp"
            app:cornerRadius="15dp"
            app:icon="@drawable/ic_auto_awesome"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="18dp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/brand_indigo"
            app:trackColor="@color/surface_alt" />

        <TextView
            android:id="@+id/errorText"
            style="@style/TextAppearance.TaskFlow.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/rose"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/resultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/planSummary"
                style="@style/TextAppearance.TaskFlow.BodyStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/planSource"
                style="@style/TextAppearance.TaskFlow.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:id="@+id/planList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApply"
                style="@style/Widget.TaskFlow.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Aplicar plano"
                app:cornerRadius="15dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="@color/divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReorganize"
            style="@style/Widget.TaskFlow.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Só reorganizar minhas tarefas sem horário"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfigure"
            style="@style/Widget.TaskFlow.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Configurar chave do Gemini"
            android:textColor="@color/brand_indigo"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
