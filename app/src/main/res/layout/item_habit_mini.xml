<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <View
        android:id="@+id/dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_dot" />

    <TextView
        android:id="@+id/name"
        style="@style/TextAppearance.TaskFlow.BodyStrong"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="13sp"
        android:text="Beber água" />

    <ImageView
        android:id="@+id/check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/ic_radio_button_unchecked"
        app:tint="@color/text_tertiary" />

    <TextView
        android:id="@+id/streak"
        style="@style/TextAppearance.TaskFlow.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jakarta_bold"
        android:textColor="@color/amber"
        android:textSize="11sp"
        android:text="12d" />
</LinearLayout>
