<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.TaskFlow.H1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Produtos &amp; Gastos" />

            <TextView
                android:id="@+id/subtitle"
                style="@style/TextAppearance.TaskFlow.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="10 compras · total do mês R$ 0,00" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSheet"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Planilha de preços"
            android:padding="10dp"
            android:src="@drawable/ic_receipt_long"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnCharts"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Gráficos de preços"
            android:padding="10dp"
            android:src="@drawable/ic_show_chart"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_hero"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            style="@style/TextAppearance.TaskFlow.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gastos do mês"
            android:textColor="@color/hero_text_muted" />

        <TextView
            android:id="@+id/monthTotal"
            style="@style/TextAppearance.TaskFlow.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="R$ 0,00"
            android:textColor="@color/white"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dayTotal"
                style="@style/TextAppearance.TaskFlow.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hoje: R$ 0,00 · 0 itens"
                android:textColor="@color/hero_text_muted" />

            <TextView
                android:id="@+id/monthItems"
                style="@style/TextAppearance.TaskFlow.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 itens no mês"
                android:textColor="@color/hero_text_muted" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.TaskFlow.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/TextAppearance.TaskFlow.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adicionar produto"
                android:textColor="@color/brand_indigo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBarcode"
                    style="@style/Widget.TaskFlow.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Código"
                    android:textSize="11.5sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_qr_code_scanner"
                    app:iconGravity="textStart"
                    app:iconPadding="3dp"
                    app:iconSize="17dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnCamera"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:background="@drawable/bg_fab"
                        android:contentDescription="Adicionar produto com a câmera"
                        android:elevation="6dp"
                        android:padding="18dp"
                        android:src="@drawable/ic_photo_camera"
                        app:tint="@color/white" />

                    <TextView
                        style="@style/TextAppearance.TaskFlow.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Foto com IA"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManual"
                    style="@style/Widget.TaskFlow.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Manual"
                    android:textSize="11.5sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:iconPadding="3dp"
                    app:iconSize="17dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextAppearance.TaskFlow.H2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Compras recentes"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/recentCount"
            style="@style/TextAppearance.TaskFlow.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/purchaseList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_shopping_bag"
                app:tint="@color/text_tertiary" />

            <TextView
                style="@style/TextAppearance.TaskFlow.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Nenhuma compra registrada" />

            <TextView
                style="@style/TextAppearance.TaskFlow.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Use a câmera para adicionar seu primeiro produto." />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
