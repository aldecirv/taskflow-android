<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TaskFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_indigo</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/indigo_100</item>
        <item name="colorOnPrimaryContainer">@color/indigo_900</item>
        <item name="colorSecondary">@color/brand_violet</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/violet_50</item>
        <item name="colorOnSecondaryContainer">@color/brand_purple</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorOutlineVariant">@color/border</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurfaceVariant">@color/surface_alt</item>
        <item name="android:fontFamily">@font/jakarta_regular</item>
        <item name="fontFamily">@font/jakarta_regular</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="materialCardViewStyle">@style/Widget.TaskFlow.Card</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TaskFlow.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.TaskFlow.BottomSheet</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.TaskFlow.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_indigo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_indigo</item>
        <item name="postSplashScreenTheme">@style/Theme.TaskFlow</item>
    </style>

    <style name="Theme.TaskFlow.Camera" parent="Theme.TaskFlow">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="ThemeOverlay.TaskFlow.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TaskFlow.Dialog</item>
    </style>

    <style name="ShapeAppearance.TaskFlow.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ThemeOverlay.TaskFlow.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.TaskFlow.BottomSheet</item>
    </style>

    <style name="Widget.TaskFlow.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TaskFlow.Sheet</item>
        <item name="backgroundTint">@color/surface</item>
    </style>

    <style name="ShapeAppearance.TaskFlow.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
    </style>

    <!-- Accent overlays -->
    <style name="ThemeOverlay.TaskFlow.Indigo" parent="">
        <item name="colorPrimary">@color/brand_indigo</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>
    <style name="ThemeOverlay.TaskFlow.Violet" parent="">
        <item name="colorPrimary">@color/brand_violet</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>
    <style name="ThemeOverlay.TaskFlow.Emerald" parent="">
        <item name="colorPrimary">@color/emerald_dark</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>
    <style name="ThemeOverlay.TaskFlow.Amber" parent="">
        <item name="colorPrimary">@color/amber</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>
    <style name="ThemeOverlay.TaskFlow.Rose" parent="">
        <item name="colorPrimary">@color/rose</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>
    <style name="ThemeOverlay.TaskFlow.Cyan" parent="">
        <item name="colorPrimary">@color/cyan</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="Widget.TaskFlow.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:layout_marginBottom">0dp</item>
    </style>

    <style name="Widget.TaskFlow.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.TaskFlow.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="strokeColor">@color/border</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.TaskFlow.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.TaskFlow.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/brand_indigo</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <style name="Widget.TaskFlow.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">100dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.TaskFlow.NavItem" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <style name="Widget.TaskFlow.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.TaskFlow.NavIndicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.TaskFlow.NavActive</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.TaskFlow.NavInactive</item>
    </style>

    <style name="Widget.TaskFlow.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/indigo_100</item>
        <item name="shapeAppearance">@style/ShapeAppearance.TaskFlow.Pill</item>
    </style>

    <style name="ShapeAppearance.TaskFlow.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">100dp</item>
    </style>
</resources>
